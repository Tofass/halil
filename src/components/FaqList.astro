---
import Icon from "./Icon.astro";
import type { QA } from "../data/faq";

interface Props { items: QA[] }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((item) => (
    <details class="faq-item">
      <summary>
        <span>{item.q}</span>
        <Icon name="plus" class="faq-plus" />
      </summary>
      <div class="faq-a">
        {item.a.map((b) =>
          typeof b === "string" ? (
            <p>{b}</p>
          ) : (
            <div>
              {b.lead && <p class="faq-lead">{b.lead}</p>}
              <ul>{b.list.map((li) => <li>{li}</li>)}</ul>
            </div>
          ),
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .faq-list { display: grid; gap: var(--space-75); }
  .faq-item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .faq-item[open] { border-color: var(--ink); }
  summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: var(--space-200);
    padding: var(--space-200) var(--space-200); font-weight: 600; font-size: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  :global(.faq-plus) { width: 22px; height: 22px; flex: none; color: var(--ink); transition: transform 250ms var(--ease); }
  .faq-item[open] :global(.faq-plus) { transform: rotate(45deg); }
  .faq-a { padding: 0 var(--space-200) var(--space-200); display: grid; gap: var(--space-100); color: var(--muted); }
  .faq-lead { color: var(--ink); font-weight: 600; margin-bottom: var(--space-50); }
  .faq-a ul { padding-left: var(--space-200); display: grid; gap: var(--space-50); }
</style>
