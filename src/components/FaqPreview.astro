---
import FaqList from "./FaqList.astro";
import Icon from "./Icon.astro";
import { faq } from "../data/faq";
import { url } from "../data/site";

const top = faq.flatMap((c) => c.items.filter((i) => i.top)).slice(0, 8);
---
<section class="section section--alt" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-side reveal">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">Частые вопросы</h2>
        <p>Коротко о поступлении, TR-YÖS, документах и о том, кому подходит сопровождение.</p>
      </div>
      <nav class="faq-cats" aria-label="Разделы FAQ">
        {faq.map((c) => (
          <a href={url(`${c.slug}.html`)}>
            <span><b>{c.title}</b><small>{c.intro}</small></span>
            <Icon name="arrow" />
          </a>
        ))}
      </nav>
    </div>
    <div class="reveal"><FaqList items={top} /></div>
  </div>
</section>

<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .faq-side .section-head { margin-bottom: 28px; }
  .faq-cats { display: grid; gap: 8px; }
  .faq-cats a {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 18px;
    border-radius: var(--radius-sm); border: 1px solid var(--line); text-decoration: none; transition: border-color 0.2s, background 0.2s;
  }
  .faq-cats a:hover { border-color: var(--accent); background: var(--surface); }
  .faq-cats span { display: grid; gap: 2px; }
  .faq-cats small { color: var(--muted); font-size: 13px; }
  .faq-cats :global(svg) { width: 18px; height: 18px; flex: none; color: var(--accent); }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
