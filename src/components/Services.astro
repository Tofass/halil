---
import Icon from "./Icon.astro";
import { services } from "../data/content";
---
<section class="section section--alt" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">02 / Услуги</span>
      <h2 id="services-title">Четыре направления помощи</h2>
      <p>Берите одно направление или собирайте весь путь из пакетов. Зачисление зависит от экзаменов, требований вуза и решения приёмной комиссии.</p>
    </div>
    <div class="services">
      {services.map((s, i) => (
        <article class="service card reveal">
          <span class="service-num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.title}</h3>
          <p class="muted service-who">{s.who}</p>
          <a class="service-pack" href="#packages">{s.pack} <Icon name="arrow" /></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-200); }
  @media (min-width: 1024px) { .services { grid-template-columns: repeat(4, 1fr); } }
  .service { padding: var(--space-300); display: flex; flex-direction: column; gap: var(--space-100); }
  .service-num { font-family: var(--serif); font-size: 30px; line-height: 36px; font-weight: 600; color: var(--seal); border-bottom: 1px solid var(--line); padding-bottom: var(--space-100); }
  .service h3 { font-size: 20px; }
  .service-who { font-size: 14px; flex: 1; }
  .service-pack { padding-top: var(--space-100); border-top: 1px solid var(--line); display: inline-flex; align-items: center; gap: var(--space-75); font-weight: 600; font-size: 14px; color: var(--ink); text-decoration: underline; text-underline-offset: var(--space-50); }
  .service-pack :global(svg) { width: 16px; height: 16px; transition: transform 0.2s; }
  .service-pack:hover :global(svg) { transform: translateX(2px); }
  @media (max-width: 760px) { .services { grid-template-columns: 1fr; } }
</style>
