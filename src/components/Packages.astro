---
import Icon from "./Icon.astro";
import { packages, singleServices } from "../data/packages";
---
<section class="section" id="packages" aria-labelledby="packages-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">03 / Пакеты и цены</span>
      <h2 id="packages-title">Тарифы сопровождения</h2>
      <p>Пять пакетов и разовые услуги. Пакет 4 объединяет поступление и переезд онлайн — пакеты 2 и 3 вместе за $600 вместо $700.</p>
    </div>

    <div class="packs">
      {packages.map((p) => (
        <article class:list={["pack card reveal", { "pack--featured": p.badge }]}>
          <div class="pack-top">
            <span class="pack-num">Пакет {p.num}</span>
            {p.badge && <span class="pack-badge">{p.badge}</span>}
          </div>
          <h3>{p.title}</h3>
          <p class="pack-tag">{p.tagline}</p>
          <p class="pack-price">
            {p.oldPrice && <s>{p.oldPrice}</s>}
            <b>{p.price}</b>
            {p.per && <span>{p.per}</span>}
          </p>
          {p.priceNote && <p class="pack-note">{p.priceNote}</p>}
          <ul>
            {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
          </ul>
          <a class:list={["btn btn--block", p.badge ? "btn--paper" : "btn--ghost"]} href="#contacts" data-pack={p.id}>Выбрать пакет</a>
        </article>
      ))}
    </div>

    <div class="singles card reveal">
      <div class="singles-head">
        <h3>Разовые услуги</h3>
        <p class="muted">Если нужен один конкретный шаг, а не пакет.</p>
      </div>
      <ul>
        {singleServices.map((s) => (
          <li>
            <a href="#contacts" data-pack={s.id}>
              <span>{s.title}</span>
              <b>{s.price}</b>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="packs-note muted">
      Сроки, способ оплаты и точный состав работ уточняются на консультации. Зачисление не гарантируется: решение принимает университет.
    </p>
  </div>
</section>

<style>
  .packs { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-200); }
  .pack { grid-column: span 2; padding: var(--space-300); display: flex; flex-direction: column; gap: var(--space-75); border-top: 3px solid var(--ink); }
  .pack:nth-child(n + 4) { grid-column: span 3; }
  .pack-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-75); }
  .pack-num { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--muted); }
  .pack-badge { font-size: 12px; font-weight: 600; padding: var(--space-50) var(--space-75); border-radius: var(--radius); background: var(--seal); color: var(--seal-ink); }
  .pack h3 { font-size: 20px; }
  .pack-tag { font-size: 14px; color: var(--muted); }
  .pack-note { font-size: 14px; line-height: 20px; color: var(--muted); }
  .pack-price { display: flex; align-items: baseline; gap: var(--space-75); margin: var(--space-75) 0 var(--space-50); }
  .pack-price b { font-family: var(--serif); font-size: 48px; line-height: 48px; font-weight: 600; color: var(--seal); }
  .pack-price span { color: var(--muted); font-size: 14px; }
  .pack-price s { color: var(--muted); font-size: 18px; }
  .pack ul { list-style: none; display: grid; gap: var(--space-75); margin-bottom: var(--space-200); flex: 1; }
  .pack li { display: flex; gap: var(--space-75); font-size: 14px; }
  .pack li :global(svg) { width: 18px; height: 18px; flex: none; margin-top: var(--space-25); color: var(--ink); }

  .pack--featured { background: var(--plate); color: var(--plate-ink); border-color: var(--plate); border-top-color: var(--plate-ink); }
  .pack--featured .pack-num, .pack--featured .pack-tag, .pack--featured .pack-price span, .pack--featured .pack-price s { color: var(--plate-muted); }
  .pack--featured .pack-price b { color: var(--plate-ink); }
  .pack--featured li :global(svg) { color: var(--plate-ink); }
  .pack--featured :focus-visible { outline-color: var(--plate-ink); }
  :global([data-theme="dark"]) .pack--featured { border-color: var(--plate-line); border-top-color: var(--plate-ink); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .pack--featured { border-color: var(--plate-line); border-top-color: var(--plate-ink); } }

  .singles { margin-top: var(--space-200); padding: var(--space-300); display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-300); align-items: center; }
  .singles h3 { font-size: 20px; margin-bottom: var(--space-50); }
  .singles ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-75); }
  .singles a {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-100); padding: var(--space-100) var(--space-200);
    border-radius: var(--radius-sm); background: var(--bg-alt); border: 1px solid var(--line); text-decoration: none; font-size: 14px; font-weight: 600;
    transition: border-color 200ms var(--ease);
  }
  .singles a:hover { border-color: var(--ink); }
  .singles a b { color: var(--seal); white-space: nowrap; }
  .packs-note { margin-top: var(--space-200); font-size: 14px; }

  @media (max-width: 980px) {
    .packs { grid-template-columns: 1fr 1fr; }
    .pack, .pack:nth-child(n + 4) { grid-column: span 1; }
    .pack--featured { grid-column: 1 / -1; order: -1; }
    .singles { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .packs { grid-template-columns: 1fr; }
    .singles ul { grid-template-columns: 1fr; }
  }
</style>
