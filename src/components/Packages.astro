---
import Icon from "./Icon.astro";
import { packages, singleServices } from "../data/packages";
---
<section class="section" id="packages" aria-labelledby="packages-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Пакеты и цены</span>
      <h2 id="packages-title">Тарифы сопровождения</h2>
      <p>Пять пакетов и разовые услуги. Пакет 4 объединяет поступление и переезд онлайн — пакеты 2 и 3 вместе за $600 вместо $700.</p>
    </div>

    <div class="packs">
      {packages.map((p) => (
        <article class:list={["pack card reveal", { "pack--featured": p.badge }]}>
          <div class="pack-top">
            <span class="pack-num">Пакет {p.num}</span>
            {p.badge && <span class="pack-badge">{p.badge}</span>}
          </div>
          <h3>{p.title}</h3>
          <p class="pack-tag">{p.tagline}</p>
          <p class="pack-price">
            {p.oldPrice && <s>{p.oldPrice}</s>}
            <b>{p.price}</b>
            {p.per && <span>{p.per}</span>}
          </p>
          <ul>
            {p.features.map((f) => <li><Icon name="check" />{f}</li>)}
          </ul>
          <a class:list={["btn btn--block", p.badge ? "btn--accent" : "btn--ghost"]} href="#contacts" data-pack={p.id}>Выбрать пакет</a>
        </article>
      ))}
    </div>

    <div class="singles card reveal">
      <div class="singles-head">
        <h3>Разовые услуги</h3>
        <p class="muted">Если нужен один конкретный шаг, а не пакет.</p>
      </div>
      <ul>
        {singleServices.map((s) => (
          <li>
            <a href="#contacts" data-pack={s.id}>
              <span>{s.title}</span>
              <b>{s.price}</b>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="packs-note muted">
      Сроки, способ оплаты и точный состав работ уточняются на консультации. Зачисление не гарантируется: решение принимает университет.
    </p>
  </div>
</section>

<style>
  .packs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 18px; }
  .pack { grid-column: span 2; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .pack:nth-child(n + 4) { grid-column: span 3; }
  .pack-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .pack-num { font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .pack-badge { font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); }
  .pack h3 { font-size: 22px; }
  .pack-tag { font-size: 14px; color: var(--muted); }
  .pack-price { display: flex; align-items: baseline; gap: 8px; margin: 8px 0 6px; }
  .pack-price b { font-family: var(--serif); font-size: 44px; line-height: 1; }
  .pack-price span { color: var(--muted); font-size: 15px; }
  .pack-price s { color: var(--muted); font-size: 18px; }
  .pack ul { list-style: none; display: grid; gap: 8px; margin-bottom: 18px; flex: 1; }
  .pack li { display: flex; gap: 10px; font-size: 15px; }
  .pack li :global(svg) { width: 18px; height: 18px; flex: none; margin-top: 3px; color: var(--accent); }

  .pack--featured { background: var(--dark); color: var(--dark-ink); border-color: var(--dark); box-shadow: var(--shadow); }
  .pack--featured .pack-tag, .pack--featured .pack-price span, .pack--featured .pack-price s { color: color-mix(in srgb, var(--dark-ink) 60%, transparent); }
  :global([data-theme="dark"]) .pack--featured { border-color: var(--accent); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .pack--featured { border-color: var(--accent); } }

  .singles { margin-top: 18px; padding: 28px; display: grid; grid-template-columns: 1fr 2fr; gap: 24px; align-items: center; }
  .singles h3 { font-size: 22px; margin-bottom: 6px; }
  .singles ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .singles a {
    display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px;
    border-radius: var(--radius-sm); background: var(--bg-alt); text-decoration: none; font-size: 15px; font-weight: 600;
    transition: background 0.2s;
  }
  .singles a:hover { background: var(--accent-soft); }
  .singles a b { color: var(--accent); white-space: nowrap; }
  .packs-note { margin-top: 20px; font-size: 14px; }

  @media (max-width: 980px) {
    .packs { grid-template-columns: 1fr 1fr; }
    .pack, .pack:nth-child(n + 4) { grid-column: span 1; }
    .pack--featured { grid-column: 1 / -1; order: -1; }
    .singles { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .packs { grid-template-columns: 1fr; }
    .singles ul { grid-template-columns: 1fr; }
  }
</style>
