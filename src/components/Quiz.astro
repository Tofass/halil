---
import Icon from "./Icon.astro";
import { requestOptions } from "../data/packages";

const exam = [
  { v: "yes", label: "Да, нужна подготовка" },
  { v: "no", label: "Нет или уже сдал(а)" },
  { v: "unsure", label: "Пока не знаю" },
];
const scope = [
  { v: "admission", label: "Выбрать вуз и подать документы" },
  { v: "online", label: "Поступление и переезд — онлайн" },
  { v: "full", label: "Всё под ключ, с личной встречей в Турции" },
  { v: "settle", label: "Уже поступил(а), нужен переезд и ВНЖ" },
  { v: "one-uni", label: "Только подать в один университет" },
];
const options = Object.fromEntries(requestOptions.map((o) => [o.id, { label: o.label, price: o.price }]));
---
<section class="section section--dark" id="quiz" aria-labelledby="quiz-title">
  <div class="wrap quiz-grid">
    <div class="section-head reveal">
      <span class="eyebrow">Подбор пакета</span>
      <h2 id="quiz-title">Не знаете, что выбрать? Ответьте на два вопроса</h2>
      <p>Подскажем подходящий вариант. Это ориентир — точный план составим на бесплатной консультации.</p>
    </div>

    <form class="quiz card reveal" data-options={JSON.stringify(options)}>
      <fieldset>
        <legend><span>1</span> Нужно ли вам сдавать TR-YÖS?</legend>
        <div class="opts">
          {exam.map((o) => (
            <label class="opt"><input type="radio" name="exam" value={o.v} required /><span>{o.label}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend><span>2</span> С чем нужна помощь?</legend>
        <div class="opts">
          {scope.map((o) => (
            <label class="opt"><input type="radio" name="scope" value={o.v} required /><span>{o.label}</span></label>
          ))}
        </div>
      </fieldset>

      <div class="quiz-result" aria-live="polite" hidden>
        <p class="eyebrow">Вам подойдёт</p>
        <ul class="quiz-picks"></ul>
        <p class="quiz-note muted" hidden>
          Многие университеты принимают без TR-YÖS — на консультации проверим требования ваших вузов.
        </p>
        <a class="btn btn--accent" href="#contacts">Оставить заявку <Icon name="arrow" /></a>
      </div>
    </form>
  </div>
</section>

<script>
  type Opt = { label: string; price: string };
  const form = document.querySelector<HTMLFormElement>(".quiz")!;
  const options: Record<string, Opt> = JSON.parse(form.dataset.options!);
  const result = form.querySelector<HTMLElement>(".quiz-result")!;
  const picksEl = form.querySelector<HTMLElement>(".quiz-picks")!;
  const note = form.querySelector<HTMLElement>(".quiz-note")!;
  const cta = result.querySelector<HTMLAnchorElement>("a")!;

  form.addEventListener("change", () => {
    const data = new FormData(form);
    const exam = data.get("exam");
    const scope = data.get("scope") as string | null;
    if (!exam || !scope) return;

    const picks = exam === "yes" ? ["prep", scope] : [scope];
    picksEl.replaceChildren(
      ...picks.map((id) => {
        const li = document.createElement("li");
        const name = document.createElement("span");
        const price = document.createElement("b");
        name.textContent = options[id].label;
        price.textContent = options[id].price;
        li.append(name, price);
        return li;
      }),
    );
    note.hidden = exam !== "unsure";
    result.hidden = false;
    cta.dataset.pack = scope;
    cta.dataset.note = `Подбор пакета: ${picks.map((id) => options[id].label).join(" + ")}.`;
  });
</script>

<style>
  .quiz-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .quiz { background: var(--surface); color: var(--ink); padding: clamp(22px, 3vw, 34px); display: grid; gap: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 800; font-size: 17px; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  legend span { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font-size: 13px; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { cursor: pointer; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt span { display: inline-block; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line); font-size: 14px; font-weight: 600; transition: all 0.15s; }
  .opt:hover span { border-color: var(--accent); }
  .opt input:checked + span { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .opt input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }
  .quiz-result { padding-top: 22px; border-top: 1px solid var(--line); display: grid; gap: 14px; justify-items: start; }
  .quiz-result[hidden] { display: none; }
  .quiz-picks { list-style: none; display: grid; gap: 8px; width: 100%; }
  .quiz-picks :global(li) { display: flex; justify-content: space-between; gap: 12px; padding: 14px 16px; border-radius: var(--radius-sm); background: var(--accent-soft); font-weight: 700; }
  .quiz-picks :global(b) { color: var(--accent); white-space: nowrap; }
  .quiz-note { font-size: 14px; }
  @media (max-width: 860px) { .quiz-grid { grid-template-columns: 1fr; } .section-head { margin-bottom: 0; } }
</style>
