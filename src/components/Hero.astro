---
import Icon from "./Icon.astro";
import { url } from "../data/site";

// Facts taken from the previous site versions, nothing invented.
const proof = ["Группы до 5 человек", "3 урока в неделю", "TR-YÖS: 100 минут, 80 вопросов"];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker"><span class="dot" aria-hidden="true"></span> Поступление в университеты Турции</p>
      <h1 id="hero-title">От мечты о Турции <em>до студенческого билета</em></h1>
      <p class="hero-sub">
        Готовим к TR-YÖS, подбираем университет, собираем документы и помогаем переехать. Можно взять один шаг или весь путь целиком.
      </p>
      <div class="hero-cta">
        <a class="btn btn--accent" href="#level">Пройти мини-тест <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#contacts">Получить консультацию</a>
      </div>
      <ul class="hero-proof">
        {proof.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <figure class="hero-photo">
      <picture>
        <source media="(max-width: 760px)" srcset={url("assets/hero-960.webp")} />
        <img src={url("assets/hero.webp")} alt="Стамбул на закате: Галатский мост и мечеть Йени-Джами" width="1920" height="1200" fetchpriority="high" />
      </picture>
      <figcaption>Стамбул. Галатский мост и мечеть Йени-Джами</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding: var(--space-600) 0; background: var(--bg); }
  .hero-grid { display: grid; gap: var(--space-400); align-items: center; }
  .hero-kicker { display: inline-flex; align-items: center; gap: var(--space-100); font-size: 14px; line-height: 20px; font-weight: 600; color: var(--seal); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cta); }
  h1 { margin-top: var(--space-200); max-width: 640px; }
  h1 em { font-style: normal; color: var(--seal); }
  .hero-sub { margin-top: var(--space-300); max-width: 520px; font-size: 18px; line-height: 28px; color: var(--muted); }
  .hero-cta { margin-top: var(--space-400); display: flex; flex-wrap: wrap; gap: var(--space-100); }
  .hero-cta .btn { min-height: 52px; }
  .hero-cta .btn--ghost { border-color: var(--ink); color: var(--ink); }
  .hero-proof { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-75) var(--space-400); margin-top: var(--space-400); padding-top: var(--space-200); border-top: 1px solid var(--line); font-size: 14px; line-height: 20px; color: var(--muted); }
  .hero-proof li { display: flex; gap: var(--space-100); }
  .hero-proof li::before { content: ""; width: 6px; height: 6px; margin-top: 7px; flex: none; background: var(--cta); border-radius: 50%; }

  .hero-photo { margin: 0; border-radius: var(--radius); overflow: hidden; background: var(--bg-alt); }
  .hero-photo img { width: 100%; height: auto; aspect-ratio: 5 / 4; object-fit: cover; object-position: 60% 40%; }
  .hero-photo figcaption { padding: var(--space-75) var(--space-200); font-size: 14px; line-height: 20px; color: var(--muted); }

  @media (min-width: 1024px) {
    .hero { padding: var(--space-800) 0; }
    .hero-grid { grid-template-columns: 1fr 1.05fr; gap: var(--space-600); }
    h1 { font-size: 72px; line-height: 0.98; letter-spacing: -0.02em; }
  }
  @media (max-width: 560px) { .hero-cta .btn { flex: 1 1 100%; } }
</style>
