---
import Icon from "./Icon.astro";
import { url } from "../data/site";

// Facts taken from the previous site versions, nothing invented.
const proof = ["Группы до 5 человек", "3 урока в неделю", "TR-YÖS: 100 минут, 80 вопросов"];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">Поступление в университеты Турции</p>
      <h1 id="hero-title">От мечты о Турции — <em>до студенческого билета</em></h1>
      <p class="hero-sub">
        Помогаем подготовиться к TR-YÖS, выбрать университет, собрать документы и переехать. Можно взять один шаг или весь путь целиком.
      </p>
      <div class="hero-cta">
        <a class="btn btn--accent" href="#contacts">Получить консультацию <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#quiz">Подобрать пакет</a>
      </div>
    </div>

    <figure class="hero-photo">
      <picture>
        <source media="(max-width: 760px)" srcset={url("assets/hero-960.webp")} />
        <img src={url("assets/hero.webp")} alt="Стамбул на закате: Галатский мост и мечеть Йени-Джами" width="1920" height="1200" fetchpriority="high" />
      </picture>
      <figcaption>Стамбул. Галатский мост и мечеть Йени-Джами</figcaption>
    </figure>

    <ul class="hero-proof">
      {proof.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero { padding: var(--space-600) 0 var(--space-700); }
  /* Mobile order: copy (label, heading, lead, buttons), photo with caption, facts. */
  .hero-grid { display: grid; gap: var(--space-400); }
  .hero-kicker { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--muted); margin-bottom: var(--space-200); }
  h1 { max-width: 680px; }
  h1 em { font-style: italic; font-weight: 600; }
  .hero-sub { margin-top: var(--space-300); max-width: 560px; font-size: 18px; line-height: 28px; color: var(--muted); }
  .hero-cta { margin-top: var(--space-400); display: flex; flex-wrap: wrap; gap: var(--space-100); }
  .hero-photo { margin: 0; background: var(--surface); border: 1px solid var(--ink); padding: var(--space-75); }
  .hero-photo img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 60% 40%; border-radius: 0; }
  .hero-photo figcaption { padding-top: var(--space-75); font-size: 12px; line-height: 16px; color: var(--muted); }
  .hero-proof { list-style: none; display: grid; gap: var(--space-75); font-size: 14px; line-height: 20px; color: var(--muted); border-top: 1px solid var(--line); padding-top: var(--space-200); }
  .hero-proof li { display: flex; gap: var(--space-100); }
  .hero-proof li::before { content: ""; width: 6px; height: 6px; margin-top: 7px; flex: none; background: var(--ink); }

  @media (min-width: 640px) {
    .hero-proof { display: flex; flex-wrap: wrap; gap: var(--space-75) var(--space-400); }
  }
  @media (min-width: 1024px) {
    .hero { padding: var(--space-800) 0; }
    .hero-grid { grid-template-columns: 1.05fr 1fr; grid-template-areas: "copy photo" "proof photo"; column-gap: var(--space-700); align-items: start; }
    .hero-copy { grid-area: copy; }
    .hero-photo { grid-area: photo; }
    .hero-proof { grid-area: proof; align-self: end; }
  }
  @media (max-width: 560px) { .hero-cta .btn { flex: 1 1 100%; } }
</style>
