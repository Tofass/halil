---
import Icon from "./Icon.astro";
import { url } from "../data/site";

// Facts taken from the previous site versions, nothing invented.
const proof = ["Группы до 5 человек", "3 урока в неделю", "TR-YÖS: 100 минут, 80 вопросов"];
// Printed formulas under the lead: the exam is logic and maths, so the first screen shows it.
const formulas = "2, 6, 18, 54, …   ·   3x + 5 = 20   ·   a : b = 2 : 3   ·   15% от 240";
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-bg" aria-hidden="true">
    <source media="(max-width: 760px)" srcset={url("assets/hero-960.webp")} />
    <img src={url("assets/hero.webp")} alt="" width="1920" height="1200" fetchpriority="high" />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="wrap hero-grid">
    <p class="hero-kicker">Поступление в университеты Турции</p>
    <h1 id="hero-title">От мечты о Турции — до студенческого билета</h1>
    <p class="hero-sub">
      Готовим к TR-YÖS, подбираем университет, собираем документы и помогаем переехать. Можно взять один шаг или весь путь целиком.
    </p>
    <div class="hero-cta">
      <a class="btn btn--accent" href="#level">Пройти мини-тест <Icon name="arrow" /></a>
      <a class="btn btn--outline" href="#contacts">Получить консультацию</a>
    </div>
    <p class="hero-formulas" aria-hidden="true">{formulas}</p>
    <ul class="hero-proof">
      {proof.map((c) => <li>{c}</li>)}
    </ul>
    <p class="hero-caption">Стамбул. Галатский мост и мечеть Йени-Джами</p>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; color: var(--plate-ink); background: var(--plate); min-height: min(860px, 100svh); display: flex; align-items: center; padding: var(--space-800) 0 var(--space-600); }
  .hero-bg, .hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-bg img { object-fit: cover; object-position: 62% 40%; }
  .hero-bg { z-index: -2; }
  /* One flat ink layer keeps the text readable on the photo. No gradient. */
  .hero-shade { position: absolute; inset: 0; z-index: -1; background: rgba(28, 25, 21, 0.6); }

  .hero-grid { display: grid; gap: var(--space-300); max-width: var(--max); justify-items: start; }
  .hero-kicker { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--plate-muted); }
  h1 { max-width: 720px; color: var(--plate-ink); font-size: 36px; line-height: 40px; }
  .hero-sub { max-width: 560px; font-size: 18px; line-height: 28px; color: var(--plate-ink); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-100); margin-top: var(--space-100); }
  .hero-cta .btn--accent { background: var(--seal); color: #fbfaf6; }
  .hero-cta .btn--accent:hover { background: var(--seal-hover); }
  .btn--outline { background: transparent; color: var(--plate-ink); border-color: var(--plate-ink); }
  .btn--outline:hover { background: color-mix(in srgb, var(--plate-ink) 10%, transparent); }
  .hero-formulas { font-family: var(--serif); font-size: 16px; line-height: 24px; color: color-mix(in srgb, var(--plate-ink) 70%, transparent); }
  .hero-proof { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-75) var(--space-300); font-size: 14px; line-height: 20px; color: var(--plate-ink); padding-top: var(--space-200); border-top: 1px solid var(--plate-line); }
  .hero-proof li { display: flex; gap: var(--space-75); }
  .hero-proof li::before { content: ""; width: 6px; height: 6px; margin-top: 7px; flex: none; background: var(--plate-ink); }
  .hero-caption { position: absolute; right: var(--gutter); bottom: var(--space-200); font-size: 12px; line-height: 16px; color: color-mix(in srgb, var(--plate-ink) 75%, transparent); }

  @media (max-width: 560px) {
    .hero { padding: var(--space-600) 0 var(--space-500); }
    h1 { font-size: 30px; line-height: 36px; }
    .hero-cta .btn { flex: 1 1 100%; }
    .hero-caption { position: static; margin-top: var(--space-100); }
  }
  @media (min-width: 768px) {
    h1 { font-size: 48px; line-height: 48px; }
  }
  @media (min-width: 1024px) {
    h1 { font-size: 60px; line-height: 60px; }
  }
</style>
