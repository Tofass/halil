---
import Icon from "./Icon.astro";
import { url } from "../data/site";

// Facts taken from the previous site versions, nothing invented.
const proof = ["Группы до 5 человек", "3 урока в неделю", "TR-YÖS: 100 минут, 80 вопросов"];
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-bg">
    <source media="(max-width: 760px)" srcset={url("assets/hero-960.webp")} />
    <img src={url("assets/hero.webp")} alt="Стамбул на закате: Галатский мост и мечеть Йени-Джами" width="1920" height="1200" fetchpriority="high" />
  </picture>
  <div class="wrap hero-inner">
    <p class="hero-kicker">Поступление в университеты Турции</p>
    <h1 id="hero-title">От мечты о Турции — <span>до студенческого билета</span></h1>
    <p class="hero-sub">
      Помогаем подготовиться к TR-YÖS, выбрать университет, собрать документы и переехать. Можно взять один шаг или весь путь целиком.
    </p>
    <div class="hero-cta">
      <a class="btn btn--accent" href="#contacts">Получить консультацию <Icon name="arrow" /></a>
      <a class="link-quiet" href="#quiz">Подобрать пакет</a>
    </div>
    <ul class="hero-proof">
      {proof.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; color: #fffaf3;
    min-height: min(860px, calc(100svh - var(--header-h)));
    display: flex; align-items: flex-end;
    margin-top: calc(var(--header-h) * -1); padding-top: var(--header-h);
  }
  .hero-bg, .hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .hero-bg img { object-fit: cover; object-position: 60% 40%; }
  /* Flat overlay, no gradient. */
  .hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: rgba(20, 14, 10, 0.58); }
  .hero-inner { padding-top: var(--space-800); padding-bottom: var(--space-600); }
  @media (min-width: 768px) { .hero-inner { padding-bottom: var(--space-800); } }
  .hero-kicker {
    display: inline-block; margin-bottom: var(--space-300); padding: var(--space-75) var(--space-200); border-radius: 999px;
    background: rgba(255, 250, 243, 0.14); border: 1px solid rgba(255, 250, 243, 0.25);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    font-size: 14px; line-height: 20px; font-weight: 500;
  }
  h1 { max-width: 680px; }
  h1 span { color: #f2b27c; }
  .hero-sub { margin-top: var(--space-300); max-width: 680px; font-size: 18px; line-height: 28px; color: rgba(255, 250, 243, 0.88); }
  .hero-cta { margin-top: var(--space-400); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-200) var(--space-300); }
  .hero-cta .btn--accent { background: #d9773a; color: #1d1b19; }
  .hero-cta .btn--accent:hover { background: #e6874a; }
  .hero-proof { list-style: none; margin-top: var(--space-600); display: flex; flex-wrap: wrap; gap: var(--space-75) var(--space-300); font-size: 14px; line-height: 20px; color: rgba(255, 250, 243, 0.85); }
  .hero-proof li { display: inline-flex; align-items: center; gap: var(--space-75); }
  .hero-proof li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: #f2b27c; }
  @media (max-width: 560px) { .hero-cta .btn { flex: 1 1 100%; } }
</style>
