---
import Icon from "./Icon.astro";
import { url } from "../data/site";

// Facts taken from the previous site versions, nothing invented.
const proof = ["Группы до 5 человек", "3 урока в неделю", "TR-YÖS: 100 минут, 80 вопросов"];
// Decorative floating chips: the exam is logic and maths, so the first screen shows it.
const chips = ["2, 6, 18, 54, …", "3x + 5 = 20", "15% от 240", "a : b = 2 : 3", "180 км / 3 ч"];
---
<section class="hero" aria-labelledby="hero-title">
  <picture class="hero-bg" aria-hidden="true">
    <source media="(max-width: 760px)" srcset={url("assets/hero-960.webp")} />
    <img src={url("assets/hero.webp")} alt="" width="1920" height="1200" fetchpriority="high" />
  </picture>
  <div class="hero-shade" aria-hidden="true"></div>
  <ul class="chips" aria-hidden="true">
    {chips.map((c, n) => <li class={`chip chip-${n + 1}`}>{c}</li>)}
  </ul>

  <div class="wrap hero-grid">
    <p class="hero-kicker rise" style="--d: 0ms"><span class="dot"></span> Поступление в университеты Турции</p>
    <h1 id="hero-title" class="rise" style="--d: 100ms">От мечты о Турции — <em>до студенческого билета</em></h1>
    <p class="hero-sub rise" style="--d: 200ms">
      Готовим к TR-YÖS, подбираем университет, собираем документы и помогаем переехать. Можно взять один шаг или весь путь целиком.
    </p>
    <div class="hero-cta rise" style="--d: 300ms">
      <a class="btn btn--glow" href="#level">Пройти мини-тест <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href="#contacts">Получить консультацию</a>
    </div>
    <ul class="hero-proof rise" style="--d: 400ms">
      {proof.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #0f2531; color: var(--plate-ink); padding: var(--space-700) 0; }
  .hero-bg, .hero-bg img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-bg img { object-fit: cover; object-position: 62% 40%; animation: drift 24s ease-in-out infinite alternate; }
  .hero-bg { z-index: -3; }
  .hero-shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(100deg, rgba(10, 24, 32, 0.94) 0%, rgba(10, 24, 32, 0.78) 48%, rgba(10, 24, 32, 0.38) 100%); }

  .hero-grid { display: grid; gap: var(--space-300); max-width: var(--max); min-height: 520px; align-content: center; justify-items: start; }
  .hero-kicker { display: inline-flex; align-items: center; gap: var(--space-100); font-size: 14px; line-height: 20px; font-weight: 600; color: var(--plate-muted); padding: var(--space-50) var(--space-200); border: 1px solid var(--plate-line); border-radius: 999px; background: rgba(10, 24, 32, 0.5); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--hero-accent); animation: pulse 2s ease-in-out infinite; }
  h1 { max-width: 760px; color: var(--plate-ink); }
  h1 em { font-style: italic; font-weight: 600; color: var(--hero-accent); }
  .hero-sub { max-width: 560px; font-size: 18px; line-height: 28px; color: var(--plate-muted); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-100); }
  .hero-proof { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-75) var(--space-400); font-size: 14px; line-height: 20px; color: var(--plate-muted); padding-top: var(--space-200); border-top: 1px solid var(--plate-line); }
  .hero-proof li { display: flex; gap: var(--space-100); }
  .hero-proof li::before { content: ""; width: 6px; height: 6px; margin-top: 7px; flex: none; background: var(--hero-accent); }

  /* Floating chips: only transform and opacity animate. */
  .chips { list-style: none; position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .chip {
    position: absolute; padding: var(--space-75) var(--space-200); border: 1px solid var(--plate-line); border-radius: 999px;
    background: rgba(244, 241, 234, 0.08); backdrop-filter: blur(4px); color: var(--plate-ink);
    font: 500 15px/20px var(--serif); font-style: italic; white-space: nowrap;
    animation: float 7s ease-in-out infinite;
  }
  .chip-1 { top: 14%; right: 9%; animation-delay: -1s; }
  .chip-2 { top: 32%; right: 24%; animation-delay: -3s; }
  .chip-3 { top: 52%; right: 8%; animation-delay: -5s; }
  .chip-4 { top: 70%; right: 26%; animation-delay: -2s; }
  .chip-5 { top: 84%; right: 10%; animation-delay: -4s; }

  .rise { animation: rise 700ms var(--ease) both; animation-delay: var(--d, 0ms); }

  @keyframes rise { from { opacity: 0; transform: translateY(var(--space-300)); } to { opacity: 1; transform: none; } }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-14px); } }
  @keyframes drift { from { transform: scale(1.04); } to { transform: scale(1.12) translateX(-1.5%); } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  @media (max-width: 900px) {
    .chip-2, .chip-4 { display: none; }
    .chip-1 { top: 8%; right: 5%; } .chip-3 { top: 40%; right: 4%; } .chip-5 { top: 88%; right: 6%; }
    .hero-shade { background: linear-gradient(180deg, rgba(10, 24, 32, 0.9) 0%, rgba(10, 24, 32, 0.8) 100%); }
  }
  @media (max-width: 560px) {
    .hero { padding: var(--space-600) 0; }
    .hero-grid { min-height: 0; }
    .chip { display: none; }
    .hero-cta { width: 100%; }
    .hero-cta .btn { flex: 1 1 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg img, .chip, .dot, .rise { animation: none !important; }
  }
</style>
