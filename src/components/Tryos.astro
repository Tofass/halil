---
import Icon from "./Icon.astro";
import { tryos } from "../data/content";
import { url } from "../data/site";

const total = tryos.split.reduce((s, x) => s + x.count, 0);
---
<section class="section" id="tryos" aria-labelledby="tryos-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Экзамен</span>
      <h2 id="tryos-title">Что нужно знать о TR-YÖS</h2>
      <p>Вступительный экзамен для иностранных абитуриентов. Его результаты используют турецкие университеты при приёме.</p>
    </div>

    <div class="tryos-grid">
      <div class="card tryos-exam reveal">
        <dl class="facts">
          {tryos.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
        <div class="split" role="img" aria-label={tryos.split.map((s) => `${s.label}: ${s.count}`).join(", ")}>
          {tryos.split.map((s, i) => <span class={`seg seg-${i}`} style={`flex:${s.count}`}></span>)}
        </div>
        <ul class="split-legend">
          {tryos.split.map((s, i) => (
            <li><i class={`seg-${i}`}></i>{s.label} <b>{s.count}</b> <span class="muted">({Math.round((s.count / total) * 100)}%)</span></li>
          ))}
        </ul>
        <div class="lessons">
          <h3>Как проходят наши занятия</h3>
          <p class="muted">Группы до 5 человек: 3 урока в неделю и 1 бесплатное общее занятие по логике. Записи уроков, пробные тесты и разбор ошибок.</p>
          <a class="btn btn--accent" href="#contacts" data-pack="prep">Записаться на подготовку <Icon name="arrow" /></a>
        </div>
      </div>

      <div class="card tryos-topics reveal">
        <h3>Темы экзамена</h3>
        {tryos.topics.map((t) => (
          <div class="topic">
            <h4>{t.title}</h4>
            <ul>{t.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
        <a class="more" href={url("faq-tryos.html")}>Все вопросы о TR-YÖS <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .tryos-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 18px; align-items: start; }
  .tryos-exam, .tryos-topics { padding: clamp(22px, 3vw, 34px); }
  .facts { margin: 0 0 28px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .facts div { display: flex; flex-direction: column-reverse; }
  .facts dd { margin: 0; font-family: var(--serif); font-size: clamp(40px, 5vw, 56px); line-height: 1; color: var(--accent); }
  .facts dt { font-size: 14px; color: var(--muted); margin-top: 6px; }
  .split { display: flex; gap: 4px; height: 14px; border-radius: 999px; overflow: hidden; }
  .seg-0 { background: var(--accent); }
  .seg-1 { background: color-mix(in srgb, var(--accent) 55%, var(--bg)); }
  .seg-2 { background: color-mix(in srgb, var(--accent) 25%, var(--bg)); }
  .split-legend { list-style: none; margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; }
  .split-legend li { display: flex; align-items: center; gap: 8px; }
  .split-legend i { width: 10px; height: 10px; border-radius: 3px; }
  .lessons { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; gap: 12px; justify-items: start; }
  .lessons h3, .tryos-topics h3 { font-size: 20px; }
  .tryos-topics { display: grid; gap: 20px; }
  .topic h4 { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .topic ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .topic li { font-size: 13px; padding: 5px 10px; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--line); }
  .more { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--accent); text-decoration: none; }
  .more :global(svg) { width: 16px; height: 16px; }
  @media (max-width: 860px) { .tryos-grid { grid-template-columns: 1fr; } }
</style>
