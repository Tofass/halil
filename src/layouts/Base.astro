---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { nav, socials, WA_LINK, url } from "../data/site";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url("assets/og.jpg"), Astro.site);
const home = url("/");
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <meta name="theme-color" content="#e6e2d9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="FahriYOS.EDU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Literata:ital,wght@0,400;0,600;1,400;1,600&family=Onest:wght@400;500;600&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
      try {
        const t = localStorage.getItem("fahriyos-theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>

    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={home} aria-label="FahriYOS.EDU — на главную">
          <img src={url("assets/mark.webp")} alt="" width="40" height="33" />
          <span>FahriYOS<b>.EDU</b></span>
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Основное меню">
          {nav.map((n) => <a href={`${home}${n.href}`}>{n.label}</a>)}
          <a class="btn btn--accent nav-cta" href={`${home}#contacts`}>Консультация</a>
        </nav>
        <div class="header-tools">
          <button class="icon-btn theme-toggle" type="button" aria-label="Сменить тему">
            <Icon name="moon" class="i-moon" /><Icon name="sun" class="i-sun" />
          </button>
          <a class="btn btn--accent header-cta" href={`${home}#contacts`}>Консультация</a>
          <button class="icon-btn nav-toggle" type="button" aria-label="Меню" aria-expanded="false" aria-controls="site-nav">
            <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <a class="brand" href={home}>
            <img src={url("assets/mark.webp")} alt="" width="40" height="33" loading="lazy" />
            <span>FahriYOS<b>.EDU</b></span>
          </a>
          <p>Study &amp; life in Türkiye. Подготовка к TR-YÖS, поступление, документы и переезд.</p>
        </div>
        <div>
          <h3>Разделы</h3>
          <ul>{nav.map((n) => <li><a href={`${home}${n.href}`}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <h3>FAQ</h3>
          <ul>
            <li><a href={url("faq-admission.html")}>Поступление</a></li>
            <li><a href={url("faq-tryos.html")}>TR-YÖS</a></li>
            <li><a href={url("faq-docs.html")}>Документы</a></li>
            <li><a href={url("faq-who.html")}>Кому подходит</a></li>
          </ul>
        </div>
        <div>
          <h3>Мы в соцсетях</h3>
          <ul class="socials">
            {socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <span class="social-ico" style={`--ico:url(${url(`assets/icons/${s.icon}.svg`)})`}></span>
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>© {year} FahriYOS.EDU</p>
        <p class="footer-legal">
          <a href={url("privacy.html")}>Конфиденциальность</a>
          <a href={url("terms.html")}>Условия</a>
        </p>
        <p>Зачисление не гарантируется: решение принимает университет.</p>
      </div>
    </footer>

    <a class="tg-float" href={WA_LINK} target="_blank" rel="noopener noreferrer" aria-label="Написать в WhatsApp">
      <Icon name="whatsapp" />
    </a>

    <script>
      const root = document.documentElement;
      const body = document.body;

      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("fahriyos-theme", next); } catch {}
      });

      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const setNav = (open: boolean) => {
        body.classList.toggle("nav-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
      };
      toggle?.addEventListener("click", () => setNav(!body.classList.contains("nav-open")));
      document.querySelectorAll("#site-nav a").forEach((a) => a.addEventListener("click", () => setNav(false)));
      addEventListener("keydown", (e) => { if (e.key === "Escape") setNav(false); });

      // On phones the floating WhatsApp button hides while the contact form is on screen, so it cannot cover the submit button.
      const contacts = document.getElementById("contacts");
      if (contacts && "IntersectionObserver" in window) {
        new IntersectionObserver(([e]) => body.classList.toggle("tg-hidden", e.isIntersecting), { threshold: 0.15 }).observe(contacts);
      }

      const onScroll = () => body.classList.toggle("scrolled", scrollY > 8);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      const items = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
          }),
          { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-in"));
      }
    </script>

    <style>
      .site-header {
        position: sticky; top: 0; z-index: 50; height: var(--header-h);
        background: var(--bg); border-bottom: 1px solid var(--line);
      }
      .header-row { height: 100%; display: flex; align-items: center; gap: var(--space-300); }
      .brand { display: inline-flex; align-items: center; gap: var(--space-75); text-decoration: none; font-family: var(--serif); font-size: 20px; font-weight: 600; white-space: nowrap; }
      .brand img { width: 40px; height: 40px; object-fit: contain; border-radius: 0; background: #fbfaf6; border: 1px solid var(--ink); padding: var(--space-25); }
      .brand b { font-weight: 600; color: var(--muted); }
      .site-footer .brand b { color: var(--plate-muted); }
      .site-nav { display: flex; align-items: center; gap: var(--space-300); margin-left: auto; }
      .site-nav a:not(.btn) { text-decoration: none; font-size: 14px; font-weight: 600; color: var(--muted); transition: color 0.2s; }
      .site-nav a:not(.btn):hover { color: var(--ink); }
      .nav-cta { display: none; }
      .header-tools { display: flex; align-items: center; gap: var(--space-75); }
      .header-cta { min-height: 40px; padding: 0 var(--space-200); font-size: 14px; }
      .icon-btn { width: 40px; height: 40px; display: grid; place-items: center; border-radius: var(--radius); border: 1px solid var(--field-line); background: transparent; cursor: pointer; }
      .icon-btn :global(svg) { width: 19px; height: 19px; }
      :global(.i-sun), :global(.i-close) { display: none; }
      :global([data-theme="dark"]) :global(.i-sun) { display: block; }
      :global([data-theme="dark"]) :global(.i-moon) { display: none; }
      @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) :global(.i-sun) { display: block; }
        :global(:root:not([data-theme="light"])) :global(.i-moon) { display: none; }
      }
      .nav-toggle { display: none; }

      @media (max-width: 960px) {
        .nav-toggle { display: grid; }
        .header-cta { display: none; }
        .header-tools { margin-left: auto; }
        .site-nav {
          position: fixed; inset: var(--header-h) 0 0 0; margin: 0; z-index: 40;
          flex-direction: column; align-items: stretch; gap: 0; padding: var(--space-100) var(--gutter) var(--space-400);
          background: var(--bg); overflow-y: auto;
          opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
        }
        .site-nav a:not(.btn) { font-family: var(--serif); font-size: 24px; color: var(--ink); padding: var(--space-100) 0; border-bottom: 1px solid var(--line); }
        .nav-cta { display: inline-flex; margin-top: var(--space-300); }
        :global(body.nav-open) .site-nav { opacity: 1; visibility: visible; transform: none; }
        :global(body.nav-open) { overflow: hidden; }
        :global(body.nav-open) :global(.i-open) { display: none; }
        :global(body.nav-open) :global(.i-close) { display: block; }
      }

      .site-footer { background: var(--plate); color: var(--plate-ink); padding: var(--space-700) 0 var(--space-300); border-top: 1px solid var(--plate-line); }
      .footer-grid { display: grid; gap: var(--space-400); grid-template-columns: 1.6fr repeat(3, 1fr); }
      .footer-brand p { margin-top: var(--space-100); max-width: 320px; color: var(--plate-muted); font-size: 14px; }
      .site-footer h3 { font-family: var(--sans); font-size: 14px; line-height: 20px; font-weight: 500; color: var(--plate-muted); margin-bottom: var(--space-100); }
      .site-footer ul { list-style: none; display: grid; gap: var(--space-75); }
      .site-footer ul a { text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; gap: var(--space-75); }
      .site-footer ul a:hover { text-decoration: underline; text-underline-offset: var(--space-50); }
      .social-ico { width: 18px; height: 18px; background: currentColor; -webkit-mask: var(--ico) center / contain no-repeat; mask: var(--ico) center / contain no-repeat; }
      .footer-bottom { margin-top: var(--space-600); padding-top: var(--space-200); border-top: 1px solid var(--plate-line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-75); font-size: 12px; color: var(--plate-muted); }
      .footer-legal { display: flex; gap: var(--space-200); margin-right: auto; }
      .footer-legal a { text-underline-offset: var(--space-50); }
      .footer-legal a:hover { color: var(--plate-ink); }
      @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }

      .tg-float {
        position: fixed; right: 18px; bottom: 18px; z-index: 45; width: 56px; height: 56px; border-radius: 50%;
        display: grid; place-items: center; background: #1b7a45; color: #fff;
      }
      .tg-float:hover { background: #166338; }
      @media (max-width: 860px) {
        :global(body.tg-hidden) .tg-float { opacity: 0; pointer-events: none; transform: translateY(var(--space-300)); }
      }
      .tg-float { transition: opacity 300ms var(--ease), transform 300ms var(--ease), background-color 200ms var(--ease); }
      .tg-float :global(svg) { width: 26px; height: 26px; margin-left: -2px; }
    </style>
  </body>
</html>
